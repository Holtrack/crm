NODE_ENV=production

# Backend URL the frontend proxies API calls to (docker-internal hostname)
VITE_PROXY_TARGET=http://crm-backend:3000

# Hosts allowed to reach the preview server (comma-separated)
VITE_ALLOWED_HOSTS=crm.holtrack.com

DB_HOST=crm-postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=crm

JWT_SECRET=min-32-char-secret-change-this
JWT_EXPIRES_IN=1d

ADMIN_EMAIL=admin@holtrack.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
